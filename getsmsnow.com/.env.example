# =============================================================================
# GetSMSNow — ortam değişkenleri
# Kopyala: cp .env.example .env.local   |   Vercel: Project → Settings → Environment Variables
# =============================================================================

# ─── Site (zorunlu) ───────────────────────────────────────────────────────────
# Nereden: Kendi domain’in (prod: https://getsmsnow.com). Local: http://localhost:3003
NEXT_PUBLIC_SITE_URL=https://getsmsnow.com

# Nereden: Üret — terminal: openssl rand -base64 32
# Vercel’de Production / Preview / Development’a aynı değeri koy.
AUTH_SECRET=    

# Nereden: Genelde gerekmez; OAuth redirect hatası alırsan ekle (Auth.js / NextAuth).
# Örnek: https://getsmsnow.com
AUTH_URL=

# ─── Supabase (zorunlu — ödeme, kayıt, API) ─────────────────────────────────
# Nereden: supabase.com → Proje → Settings → API Keys
#   NEXT_PUBLIC_SUPABASE_URL = Project URL (https://xxxx.supabase.co)
#   SUPABASE_SERVICE_ROLE_KEY = service_role (gizli — sadece sunucu; client’a koyma)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ_YOUR_SERVICE_ROLE_KEY_HERE

# ─── NOWPayments — kripto ödeme (zorunlu — bakiye / misafir ödeme) ───────────
# Nereden: nowpayments.io → giriş → Store → Settings → API keys + Instant payment notifications (IPN)
#   NOWPAYMENTS_API_KEY = “API key” (public key değil)
#   NOWPAYMENTS_IPN_SECRET = IPN secret key; Dashboard’da Webhook URL: .../api/nowpayments/webhook
NOWPAYMENTS_API_KEY=YOUR_NOWPAYMENTS_API_KEY
NOWPAYMENTS_IPN_SECRET=YOUR_IPN_SECRET_KEY

# ─── Google ile giriş (opsiyonel) ───────────────────────────────────────────
# Nereden: console.cloud.google.com → APIs & Services → Credentials → OAuth 2.0 Client ID
# Authorized redirect URI: https://getsmsnow.com/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Telegram ile giriş (opsiyonel) ─────────────────────────────────────────
# Nereden: Telegram → @BotFather → /newbot; token = TELEGRAM_BOT_TOKEN
# BotFather → /setdomain → getsmsnow.com. Widget bot adı = NEXT_PUBLIC_TELEGRAM_BOT_NAME
# Kapatmak için: NEXT_PUBLIC_TELEGRAM_BOT_NAME=DISABLED
NEXT_PUBLIC_TELEGRAM_BOT_NAME=
TELEGRAM_BOT_TOKEN=

# ─── E-posta — doğrulama kodu / bildirim (opsiyonel) ─────────────────────────
# Nereden: resend.com → API Keys. Domain doğrulayınca RESEND_FROM’u kendi domain’inle değiştir.
RESEND_API_KEY=
RESEND_FROM=GetSMSNow <onboarding@resend.dev>

# ─── SMS sağlayıcı — numara satın alma (en az biri zorunlu) ──────────────────
# Öncelik: SMSPOOL_API_KEY > SMSCODE_API_TOKEN (hangisi varsa o kullanılır)
# SMSPool: smspool.net → Dashboard → API Keys
SMSPOOL_API_KEY=
# SMSCode (alternatif): smscode.gg → Dashboard → API
SMSCODE_API_TOKEN=

# ─── Cloudflare Turnstile — bot koruması (opsiyonel) ────────────────────────
# Nereden: dash.cloudflare.com → Turnstile → site oluştur → Site Key + Secret Key
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ─── Diğer ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_COOKIE_BANNER_ENABLED=false
