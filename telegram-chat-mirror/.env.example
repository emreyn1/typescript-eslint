# Copy to `.env` in this folder and fill in. `telegram_mirror.py` loads `.env`
# automatically (without overriding variables already set in your shell).

# Required — from https://my.telegram.org (user API, not BotFather)
TG_API_ID=
TG_API_HASH=
TG_PHONE=

# Required — numeric chat IDs (supergroups often -100…)
TG_SOURCE_CHAT=
TG_TARGET_CHAT=

# Optional — suffix after each copied text (use \n\n for a blank line before your line)
# TG_FOOTER=

# Optional — session + last_id.txt directory (default: ~/.cache/telegram_autoforwarder)
# TG_SESSION_DIR=
