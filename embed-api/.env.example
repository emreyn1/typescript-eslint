# ─── Server ──────────────────────────────────────────────
PORT=3001
HOST=0.0.0.0

# ─── Security ───────────────────────────────────────────
# openssl rand -hex 32
HMAC_SECRET=
URL_TTL_SECONDS=7200

# ─── CORS ────────────────────────────────────────────────
# Virgülle ayrilmis izin verilen originler (bos = hepsine izin)
ALLOWED_ORIGINS=https://yourdomain.com

# ─── Domains ─────────────────────────────────────────────
EMBED_DOMAIN=embed.yourdomain.com
SITE_DOMAIN=yourdomain.com

# ─── Database ────────────────────────────────────────────
# docker-compose otomatik set eder; standalone ise doldur
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/streamvault

# ─── HLS Cache ───────────────────────────────────────────
HLS_CACHE_PATH=/tmp/hls-cache

# ─── Cloudflare Turnstile (opsiyonel) ────────────────────
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# ─── Reklam (opsiyonel) ──────────────────────────────────
AD_VAST_URL=
AD_BUMPER_ENABLED=false

# ═══ PHASE 2 (simdilik bos bırak) ═══════════════════════

# Telegram Content Storage
TG_API_ID=
TG_API_HASH=
TG_SESSION=
TG_CHANNEL_ID=

# Cloudflare R2
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY=
CLOUDFLARE_R2_SECRET_KEY=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_PUBLIC_URL=

# Torrent Pipeline (YTS/EZTV → Real-Debrid → HLS)
TMDB_API_KEY=
TORRENT_PIPELINE_ENABLED=false
REAL_DEBRID_API_KEY=
