# Server
PORT=3001
HOST=0.0.0.0

# Security - MUST change in production
HMAC_SECRET=generate-a-64-char-random-hex-here
URL_TTL_SECONDS=7200

# CORS - comma-separated list of allowed origins (empty = allow all)
ALLOWED_ORIGINS=http://localhost:3000

# Domains
EMBED_DOMAIN=embed.yourdomain.com
SITE_DOMAIN=yourdomain.com

# Cloudflare Turnstile (optional, get from dash.cloudflare.com)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# Ads (optional)
AD_VAST_URL=
AD_BUMPER_ENABLED=false
