# Server
PORT=3001
HOST=0.0.0.0

# Security - MUST change in production
HMAC_SECRET=generate-a-64-char-random-hex-here
URL_TTL_SECONDS=7200

# CORS - comma-separated list of allowed origins (empty = allow all)
ALLOWED_ORIGINS=http://localhost:3000

# Domains
EMBED_DOMAIN=embed.yourdomain.com
SITE_DOMAIN=yourdomain.com

# Database (Phase 2)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/streamvault

# Telegram Content Storage (Phase 2)
TG_API_ID=
TG_API_HASH=
TG_SESSION=
TG_CHANNEL_ID=

# Cloudflare R2 (Phase 2)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY=
CLOUDFLARE_R2_SECRET_KEY=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_PUBLIC_URL=

# HLS Cache
HLS_CACHE_PATH=/tmp/hls-cache

# Cloudflare Turnstile (optional)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# Torrent Pipeline (YTS + EZTV → Real-Debrid → ffmpeg → HLS)
# TMDB_API_KEY: IMDB ID çevirmek için gerekli (themoviedb.org ücretsiz)
TMDB_API_KEY=
# TORRENT_PIPELINE_ENABLED=true yapınca YTS/EZTV'den otomatik kaynak arar
TORRENT_PIPELINE_ENABLED=false
# Real-Debrid API key (opsiyonel ama önerilir — magnet→HTTP çevirir)
# https://real-debrid.com/apitoken — €3/ay
REAL_DEBRID_API_KEY=

# Ads
AD_VAST_URL=
AD_BUMPER_ENABLED=false
BUMPER_AD_PATH=./assets/bumper.ts
