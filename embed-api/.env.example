# embed-api environment — copy to `.env` and fill in. All values are optional
# (sensible defaults apply, see src/config.ts); the keys most relevant to
# deployment (task 19.1) are grouped first.

# ─── Deployment essentials ───────────────────────────────────────────────
# TMDB key passed to the CinePro Core container (Req 8.2). REQUIRED for Core.
TMDB_API_KEY=

# CinePro Core base URL (Req 8.1). In docker-compose this is the private
# service name; with `docker run`/host networking use the loopback address.
# Core is NEVER published publicly (Req 6.4, 8.3).
CINEPRO_BASE_URL=http://cinepro-core:8080
CINEPRO_TIMEOUT_MS=10000

# Off-peak health cron (Resource Footprint §4). Standard 5-field cron, local
# time. Default: daily at 04:00. The sweep runs ONLY on this schedule, never
# per request. Consumed by `node dist/cli/scheduler.js` (npm run health:cron).
HEALTH_CRON_SCHEDULE=0 4 * * *
HEALTH_TEST_TITLES_PATH=./data/test-titles.json
HEALTH_REPORT_PATH=./data/provider-report.json
# Bearer token for the authed GET /admin/providers/report endpoint (Req 3.2).
HEALTH_AUTH_TOKEN=

# Core memory cap applied at deploy time to the Core container (Resource
# Footprint §3): NODE_OPTIONS=--max-old-space-size=<this>, plus a hard Docker
# --memory limit. Read here for documentation/parity; the actual caps live in
# docker-compose.yml / docker run.
CORE_MAX_OLD_SPACE_MB=512

# ─── Server ──────────────────────────────────────────────────────────────
PORT=3001
HOST=0.0.0.0
NODE_ENV=production

# ─── Security ────────────────────────────────────────────────────────────
# CHANGE THIS. In production the insecure default is rejected (Req 13.4).
HMAC_SECRET=change-this-secret-in-production
REFUSE_START_ON_INSECURE_SECRET=true
URL_TTL_SECONDS=7200

# ─── CORS / domains ──────────────────────────────────────────────────────
# Comma-separated; empty = allow all origins.
ALLOWED_ORIGINS=
EMBED_DOMAIN=embed.movieon.to
SITE_DOMAIN=movieon.to

# ─── Storage backend (cheap-VPS default = sqlite) ────────────────────────
# sqlite | json | postgres. Postgres is opt-in (set DATABASE_URL).
STORAGE_BACKEND=sqlite
SQLITE_PATH=./data/embed.db
# DATABASE_URL=postgres://user:pass@host:5432/db

# ─── Aggregation / pipeline ──────────────────────────────────────────────
AGGREGATOR_ENABLED=true
TORRENT_PIPELINE_ENABLED=false
EXCLUDE_UNHEALTHY_PROVIDERS=true

# ─── Proxy / caching economics (Resource Footprint §2/§3) ────────────────
# proxy | playlist-only | redirect. Use playlist-only/redirect at public scale.
PROXY_MODE=proxy
CORE_OMSS_CACHE_ENABLED=true
AGGREGATOR_CACHE_TTL_MS=15000
PROVIDER_FANOUT_CONCURRENCY=4
MANIFEST_CACHE_TTL_SEC=30

# ─── Public embed surface + ads (Req 11/12) ──────────────────────────────
PUBLIC_EMBED_ENABLED=true
AD_BUMPER_ENABLED=false
AD_VAST_URL=

# ─── Abuse / rate limiting (Req 13) ──────────────────────────────────────
RATE_LIMIT_BACKEND=memory
RATE_LIMIT_WINDOW_SEC=60
RATE_LIMIT_MAX_PER_IP=120
RATE_LIMIT_MAX_PER_REFERER=600
API_RATE_LIMIT_MAX_PER_IP=60
# REDIS_URL=redis://127.0.0.1:6379

# ─── Bot check (Cloudflare Turnstile, Req 13.2) ──────────────────────────
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# ─── Hotlink protection (Req 13.5) ───────────────────────────────────────
# Comma-separated host allowlist; empty = open embedding.
REFERER_ALLOWLIST=
