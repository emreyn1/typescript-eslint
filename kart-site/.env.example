# ─── Site ────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://yourdomain.com
NEXT_PUBLIC_SITE_NAME=PrivacyCards

# ─── Auth ────────────────────────────────────────────────
# openssl rand -hex 32
AUTH_SECRET=

# ─── Supabase (supabase.com → Settings → API) ───────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Wanttopay (kart saglayici — wanttopay.com → API) ───
WANTTOPAY_API_KEY=
WANTTOPAY_API_URL=https://api.wanttopay.com/v1

# ─── NOWPayments (kripto top-up — nowpayments.io) ────────
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=

# ─── NexaPay (fiat — kart ile odeme — nexapay.one) ──────
# SCAM RISKI: $5 ile test et, gelirse kullan
NEXAPAY_API_KEY=
NEXAPAY_WEBHOOK_SECRET=
