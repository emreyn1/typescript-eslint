generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  password         String
  name             String?
  referralCode     String    @unique @default(cuid())
  referredBy       String?
  twoFactorSecret  String?
  twoFactorEnabled Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  wallets      Wallet[]
  cards        Card[]
  transactions Transaction[]
  referrals    Referral[]    @relation("ReferrerRelation")
  referredUser Referral?     @relation("ReferredRelation")
  auditLogs    AuditLog[]

  @@index([email])
  @@index([referralCode])
}

model Wallet {
  id        String   @id @default(cuid())
  userId    String
  type      String   @default("USD")
  balance   Decimal  @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([userId, type])
  @@index([userId])
}

model Card {
  id           String   @id @default(cuid())
  userId       String
  cardNumber   String   @unique
  expiryMonth  String
  expiryYear   String
  cvv          String
  cardHolder   String
  type         String   @default("VIRTUAL")
  variant      String   @default("NEXUS_3D")
  status       String   @default("ACTIVE")
  balance      Decimal  @default(0)
  dailyLimit   Decimal  @default(5000)
  monthlyLimit Decimal  @default(25000)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId])
  @@index([cardNumber])
}

model Transaction {
  id          String   @id @default(cuid())
  userId      String
  walletId    String?
  cardId      String?
  type        String
  status      String   @default("PENDING")
  amount      Decimal
  fee         Decimal  @default(0)
  currency    String   @default("USD")
  description String?
  reference   String?  @unique
  metadata    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet Wallet? @relation(fields: [walletId], references: [id], onDelete: SetNull)
  card   Card?   @relation(fields: [cardId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([walletId])
  @@index([cardId])
  @@index([reference])
  @@index([createdAt])
  @@index([type])
  @@index([status])
}

model Referral {
  id         String    @id @default(cuid())
  referrerId String
  referredId String    @unique
  bonus      Decimal   @default(5)
  status     String    @default("PENDING")
  claimedAt  DateTime?
  createdAt  DateTime  @default(now())

  referrer User @relation("ReferrerRelation", fields: [referrerId], references: [id], onDelete: Cascade)
  referred User @relation("ReferredRelation", fields: [referredId], references: [id], onDelete: Cascade)

  @@index([referrerId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  details   String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}
