# Firebase Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# ExpressTurn.com (Free TURN Server - Recommended)
NEXT_PUBLIC_EXPRESSTURN_USERNAME=your_expressturn_username
NEXT_PUBLIC_EXPRESSTURN_PASSWORD=your_expressturn_password
NEXT_PUBLIC_EXPRESSTURN_SERVER=free.expressturn.com

# Metered TURN Server (Optional - Not needed if using ExpressTurn)
NEXT_PUBLIC_METERED_DOMAIN=your_domain.metered.live
NEXT_PUBLIC_METERED_SECRET_KEY=your_metered_secret_key_here
