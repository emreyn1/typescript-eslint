"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-shopping-bag h-4 w-4\" aria-hidden=\"true\"><path d=\"M16 10a4 4 0 0 1-8 0\"></path><path d=\"M3.103 6.034h17.794\"></path><path d=\"M3.4 5.467a2 2 0 0 0-.4 1.2V20a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6.667a2 2 0 0 0-.4-1.2l-2-2.667A2 2 0 0 0 17 2H7a2 2 0 0 0-1.6.8z\"></path></svg></a></div></div></header><main class=\"flex-1\"><section class=\"relative overflow-hidden bg-secondary\"><div class=\"absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,_var(--tw-gradient-stops))] from-accent/5 via-transparent to-transparent\"></div><div class=\"relative mx-auto max-w-7xl px-4 py-24 text-center lg:px-8 lg:py-32\"><p class=\"mb-4 text-xs uppercase tracking-[0.3em] text-muted-foreground\">Alliance Aroma Business Opportunity</p><h1 class=\"font-serif text-4xl leading-tight md:text-5xl lg:text-6xl\">Turn Your Network<br/>Into Income</h1><p class=\"mx-auto mt-6 max-w-2xl text-base leading-relaxed text-muted-foreground md:text-lg\">Alliance Aroma offers a premium business model built around luxury fragrances by Genie Collection. Whether you sell directly, build a team, or qualify for our franchise program — there are multiple paths to financial freedom.</p><div class=\"mt-10 flex flex-col items-center gap-4 sm:flex-row sm:justify-center\"><button data-slot=\"button\" class=\"inline-flex items-center justify-center gap-2 whitespace-nowrap text-sm font-medium transition-all disabled:pointer-events-none disabled:opacity-50 [&amp;_svg]:pointer-events-none [&amp;_svg:not([class*=&#x27;size-&#x27;])]:size-4 shrink-0 [&amp;_svg]:shrink-0 outline-none focus-visible:border-ring focus-visible:ring-ring/50 focus-visible:ring-[3px] aria-invalid:ring-destructive/20 dark:aria-invalid:ring-destructive/40 aria-invalid:border-destructive bg-primary text-primary-foreground hover:bg-primary/90 h-10 rounded-md px-6 has-[&gt;svg]:px-4 min-w-[180px]\" disabled=\"\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-loader-circle mr-2 h-4 w-4 animate-spin\" aria-hidden=\"true\"><path d=\"M21 12a9 9 0 1 1-6.219-8.56\"></path></svg>Loading...</button><a data-slot=\"button\" class=\"inline-flex items-center justify-center gap-2 whitespace-nowrap text-sm font-medium transition-all disabled:pointer-events-none disabled:opacity-50 [&amp;_svg]:pointer-events-none [&amp;_svg:not([class*=&#x27;size-&#x27;])]:size-4 shrink-0 [&amp;_svg]:shrink-0 outline-none focus-visible:border-ring focus-visible:ring-ring/50 focus-visible:ring-[3px] aria-invalid:ring-destructive/20 dark:aria-invalid:ring-destructive/40 aria-invalid:border-destructive border bg-background shadow-xs hover:bg-accent hover:text-accent-foreground dark:bg-input/30 dark:border-input dark:hover:bg-input/50 h-10 rounded-md px-6 has-[&gt;svg]:px-4 min-w-[180px]\" href=\"/collection\">Explore Products</a></div></div></section><section class=\"mx-auto max-w-7xl px-4 py-20 lg:px-8 lg:py-28\"><div class=\"mb-14 text-center\"><p class=\"mb-3 text-xs uppercase tracking-[0.3em] text-muted-foreground\">The Model</p><h2 class=\"font-serif text-3xl md:text-4xl\">4 Ways to Earn</h2><p class=\"mx-auto mt-4 max-w-lg text-sm leading-relaxed text-muted-foreground\">Our compensation plan rewards you at every level — from your first sale to leading a global organization.</p></div><div class=\"grid gap-6 sm:grid-cols-2 lg:grid-cols-4\"><div data-slot=\"card\" class=\"text-card-foreground flex flex-col gap-6 rounded-xl border py-6 shadow-sm group border-border bg-card transition-shadow hover:shadow-lg\"><div data-slot=\"card-header\" class=\"@container/card-header grid auto-rows-min grid-rows-[auto_auto] items-start gap-2 px-6 has-data-[slot=card-action]:grid-cols-[1fr_auto] [.border-b]:pb-6 pb-3\"><div class=\"mb-3 inline-flex h-12 w-12 items-center justify-center rounded-sm bg-accent/10\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-shopping-bag h-5 w-5 text-accent\" aria-hidden=\"true\"><path d=\"M16 10a4 4 0 0 1-8 0\"></path><path d=\"M3.103 6.034h17.794\"></path><path d=\"M3.4 5.467a2 2 0 0 0-.4 1.2V20a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6.667a2 2 0 0 0-.4-1.2l-2-2.667A2 2 0 0 0 17 2H7a2 2 0 0 0-1.6.8z\"></path></svg></div><div data-slot=\"card-title\" class=\"font-semibold font-serif text-lg\">Direct Selling</div><p class=\"text-xs font-medium uppercase tracking-widest text-accent\">20–40% Discount</p></div><div data-slot=\"card-content\" class=\"px-6\"><p class=\"text-sm leading-relaxed text-muted-foreground\">Purchase products at exclusive wholesale prices and sell at retail for immediate profit. The more you sell, the deeper your discount — up to 40% off.</p></div></div><div data-slot=\"card\" class=\"text-card-foreground flex flex-col gap-6 rounded-xl border py-6 shadow-sm group border-border bg-card transition-shadow hover:shadow-lg\"><div data-slot=\"card-header\" class=\"@container/card-header grid auto-rows-min grid-rows-[auto_auto] items-start gap-2 px-6 has-data-[slot=card-action]:grid-cols-[1fr_auto] [.border-b]:pb-6 pb-3\"><div class=\"mb-3 inline-flex h-12 w-12 items-center justify-center rounded-sm bg-accent/10\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-users h-5 w-5 text-accent\" aria-hidden=\"true\"><path d=\"M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2\"></path><path d=\"M16 3.128a4 4 0 0 1 0 7.744\"></path><path d=\"M22 21v-2a4 4 0 0 0-3-3.87\"></path><circle cx=\"9\" cy=\"7\" r=\"4\"></circle></svg></div><div data-slot=\"card-title\" class=\"font-semibold font-serif text-lg\">Uni-Level Incentives</div><p class=\"text-xs font-medium uppercase tracking-widest text-accent\">10-Level Commissions</p></div><div data-slot=\"card-content\" class=\"px-6\"><p class=\"text-sm leading-relaxed text-muted-foreground\">Earn commissions on your entire team&#x27;s sales across 10 levels deep. Build your network once and earn residual income month after month.</p></div></div><div data-slot=\"card\" class=\"text-card-foreground flex flex-col gap-6 rounded-xl border py-6 shadow-sm group border-border bg-card transition-shadow hover:shadow-lg\"><div data-slot=\"card-header\" class=\"@container/card-header grid auto-rows-min grid-rows-[auto_auto] items-start gap-2 px-6 has-data-[slot=card-action]:grid-cols-[1fr_auto] [.border-b]:pb-6 pb-3\"><div class=\"mb-3 inline-flex h-12 w-12 items-center justify-center rounded-sm bg-accent/10\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-trophy h-5 w-5 text-accent\" aria-hidden=\"true\"><path d=\"M10 14.66v1.626a2 2 0 0 1-.976 1.696A5 5 0 0 0 7 21.978\"></path><path d=\"M14 14.66v1.626a2 2 0 0 0 .976 1.696A5 5 0 0 1 17 21.978\"></path><path d=\"M18 9h1.5a1 1 0 0 0 0-5H18\"></path><path d=\"M4 22h16\"></path><path d=\"M6 9a6 6 0 0 0 12 0V3a1 1 0 0 0-1-1H7a1 1 0 0 0-1 1z\"></path><path d=\"M6 9H4.5a1 1 0 0 1 0-5H6\"></path></svg></div><div data-slot=\"card-title\" class=\"font-semibold font-serif text-lg\">Ranking Incentives</div><p class=\"text-xs font-medium uppercase tracking-widest text-accent\">8 Achievement Ranks</p></div><div data-slot=\"card-content\" class=\"px-6\"><p class=\"text-sm leading-relaxed text-muted-foreground\">Unlock escalating rewards as you hit sales milestones — from Achiever to Global Director. Each rank brings bigger bonuses and exclusive perks.</p></div></div><div