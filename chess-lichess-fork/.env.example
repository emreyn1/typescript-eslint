# Lichess Fork Configuration

# Domain (production)
LILA_DOMAIN=chess.yourdomain.com
LILA_SECRET=generate-a-long-random-string

# WebRTC — ExpressTurn.com (free tier) or self-hosted coturn
EXPRESSTURN_USERNAME=
EXPRESSTURN_PASSWORD=
EXPRESSTURN_SERVER=free.expressturn.com

# Signaling server (must match Caddy/nginx proxy in production)
LICHESS_RT_SIGNAL_URL=ws://localhost:3012/lichess-rt
LICHESS_RT_ENABLED=true

# Signaling server Docker
LICHESS_ORIGIN=http://localhost:8080
PORT=3012

# Legacy names (webrtc-module browser build tools)
NEXT_PUBLIC_EXPRESSTURN_USERNAME=
NEXT_PUBLIC_EXPRESSTURN_PASSWORD=
NEXT_PUBLIC_EXPRESSTURN_SERVER=free.expressturn.com
