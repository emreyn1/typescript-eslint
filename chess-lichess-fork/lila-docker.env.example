# Add these to lila-docker/.env (or export before ./lila-docker start)
# so the lila Scala process injects window.lichessRtConfig

EXPRESSTURN_USERNAME=
EXPRESSTURN_PASSWORD=
EXPRESSTURN_SERVER=free.expressturn.com
LICHESS_RT_SIGNAL_URL=ws://localhost:3012/lichess-rt
LICHESS_RT_ENABLED=true

# Also run signaling: docker compose -f ../docker-compose.signaling.yml up -d
